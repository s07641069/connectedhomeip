# The purpose of this file is to define new custom default values of settings used when building Matter samples.
# This file only changes defaults and thus all symbols here must be promptless
# and safeguarded so that they only are applied when building Matter.

if CHIP && SOC_RISCV_TELINK_TL323X

config COMPRESS_LZMA
	depends on CHIP_OTA_REQUESTOR
	default y

config DUAL_MODE
	bool "Support dual-mode switch"
	default y
	help
		This option enables dual mode.
		To extend, need to migrate to 
		telink_tlx/Kconfig.soc later.

config DEFERRED_ATTR_STORAGE
	bool "Defer the storage time of attributes"
	default y

config TELINK_ZB_PARTITION_ADDR
	hex "zigbee partition address"
	default $(dt_node_reg_addr_hex,$(dt_nodelabel_path,slot0_zb_partition),0)

endif
