+    chip_id_check_result = efuse_get_chip_id(chip_id) ? true : false;
+#endif
+#ifdef CONFIG_SOC_RISCV_TELINK_TL321X
+    chip_id_check_result = efuse_get_chip_id(chip_id) ? false : true;
+#endif
+    if (chip_id_check_result)
